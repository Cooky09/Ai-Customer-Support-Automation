{
  "name": "AI Customer Reply Assistant",
  "nodes": [
    {
      "parameters": {
        "promptType": "define",
        "text": "=Create a reply email for this customer.\n\nCustomer name:\n{{$json[\"Customer Name\"]}}\n\nIssue category:\n{{$json.Category}}\n\nCustomer issue:\n{{$json.Summary}}\n\nPriority:\n{{$json.Priority}}",
        "options": {
          "systemMessage": "You are a professional customer support email assistant.\n\nYour task is to write a professional customer support reply using the ticket information provided.\n\nFollow this exact HTML email format:\n\n<p>Subject: Re: [Issue Subject]</p>\n\n<p>Dear [Customer Name],</p>\n\n<p>\nThank you for contacting our support team regarding your issue.\n</p>\n\n<p>\n<strong>Ticket Number:</strong> [Ticket ID]<br>\n<strong>Issue Summary:</strong> [Summary]<br>\n<strong>Priority:</strong> [Priority]\n</p>\n\n<p>\nWrite a professional response explaining the next steps.\nDo not invent solutions, refunds, discounts, or promises.\n</p>\n\n<p>\nIf you need any further assistance, please reply to this email and our team will be happy to help.\n</p>\n\n<p>\nBest Regards,<br>\nCustomer Support Team\n</p>\n\nRules:\n- Return only HTML email content.\n- Do not use markdown.\n- Do not use placeholders.\n- Do not add employee names.\n- Do not write \"Next line\" or describe formatting.\n- Keep paragraphs separated."
        }
      },
